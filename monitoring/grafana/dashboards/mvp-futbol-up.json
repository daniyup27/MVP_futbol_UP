{
  "dashboard": {
    "id": null,
    "uid": "mvp-futbol-up",
    "title": "MVP Fútbol UP - Endpoint Bienestar",
    "tags": ["mvp", "bienestar", "open-telemetry"],
    "timezone": "browser",
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "Tasa de peticiones (req/s)",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "rate(evaluaciones_registradas_total[5m])",
            "legendFormat": "Evaluaciones por segundo"
          }
        ],
        "yaxes": [
          { "label": "req/s", "show": true },
          { "show": true }
        ],
        "xaxis": { "mode": "time", "show": true }
      },
      {
        "id": 2,
        "title": "Latencia p95 (ms)",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(evaluaciones_duration_ms_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.50, rate(evaluaciones_duration_ms_bucket[5m]))",
            "legendFormat": "p50"
          }
        ],
        "yaxes": [
          { "label": "ms", "show": true },
          { "show": true }
        ],
        "xaxis": { "mode": "time", "show": true }
      },
      {
        "id": 3,
        "title": "Porcentaje de errores (%)",
        "type": "stat",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "rate(evaluaciones_duration_ms_count{status=\"error\"}[5m]) / rate(evaluaciones_duration_ms_count[5m]) * 100",
            "legendFormat": "Error %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 5 }
              ]
            },
            "unit": "percent"
          }
        }
      },
      {
        "id": 4,
        "title": "Total de evaluaciones registradas",
        "type": "stat",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
        "targets": [
          {
            "expr": "sum(evaluaciones_registradas_total)",
            "legendFormat": "Total"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      {
        "id": 5,
        "title": "Latencia promedio (ms)",
        "type": "stat",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
        "targets": [
          {
            "expr": "rate(evaluaciones_duration_ms_sum[5m]) / rate(evaluaciones_duration_ms_count[5m])",
            "legendFormat": "Promedio"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          }
        }
      }
    ],
    "time": { "from": "now-1h", "to": "now" }
  }
}
