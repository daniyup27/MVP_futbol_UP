# ============================================
# Variables de entorno para MVP Fútbol UP
# Copiar este archivo a .env y completar los valores
# NUNCA commitear el archivo .env con valores reales
# ============================================

# PostgreSQL
POSTGRES_DB=futbol_up
POSTGRES_USER=futbol_user
POSTGRES_PASSWORD=change_me_in_production

# JWT
JWT_SECRET=change_me_to_a_long_random_string

# NextAuth
NEXTAUTH_URL=http://localhost:3000

# Seudonimización Ley 1581 (ADR-16): mínimo 32 caracteres aleatorios.
# Generar con: openssl rand -hex 32   — guardarlo en Render y GitHub Secrets.
ANONIMIZATION_SALT=
